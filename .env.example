APP_ENV=local
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=payroll
BASE_URL=http://localhost/payroll
APP_URL=http://localhost
TRANSLATE_LIMIT=450000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=10

# Field-level encryption (AES-256-GCM) for sensitive Employee data.
# ENCRYPTION_KEY_V{n}: base64 32-byte AES key. Add a new version when rotating; never remove old versions
# until all rows have been re-encrypted (see database/migrate_encrypt_employee_fields.php).
# Generate a fresh key with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
ENCRYPTION_KEY_V1=
# ENCRYPTION_HMAC_KEY: separate base64 32-byte key used only for exact-match search hashes (HMAC-SHA256).
# Must never equal an ENCRYPTION_KEY_V* value. Generate the same way as above.
ENCRYPTION_HMAC_KEY=

# Payslip Distribution delivery channels. Empty = channel treated as "not configured" and
# NotificationChannelRegistry::get(code)->isConfigured() returns false (delivery falls through to
# the next channel in the fallback chain, or fails with a clear log entry if none are configured).
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Origami Payroll"
# LINE Messaging API channel access token -- LineChannel is a stub until this is set AND its
# send() is actually implemented against a real account (see LineChannel docblock).
LINE_CHANNEL_ACCESS_TOKEN=
# Telegram Bot API token -- TelegramChannel is a stub until this is set AND its send() is
# actually implemented against a real bot (see TelegramChannel docblock).
TELEGRAM_BOT_TOKEN=

# Origami HR sync -- shared by OrigamiSyncClient (bulk master-data sync) and
# OrigamiEmployeeCandidateClient (Employee List's "Sync from Origami" picker). Both stay stubs
# (throwing a clear "not implemented" error, not silently going live) until this is set AND their
# real HTTP call is implemented against a confirmed Origami API spec -- see
# docs/origami-employee-sync-api-guide.md for the employee-sync one specifically.
ORIGAMI_API_BASE_URL=http://origami.local
ORIGAMI_API_KEY=

# Origami SSO login (auth/index.php) -- JWT handshake against ORIGAMI_BASE_URL's
# /api/oauth/v2/auth, same protocol as vonconnect/admin/auth/index.php. O_CLIENT_ID/
# O_CLIENT_SECRET must match a row in Origami's m_application table registered for this app.
ORIGAMI_BASE_URL=http://origami.local
O_CLIENT_ID=
O_CLIENT_SECRET=

# Payroll Sync ingest API (POST /api/payroll-sync.ingest) -- receives Origami Payroll's
# attendance-derived cycle data (see PAYROLL_SYNC_API.md). This is the key WE hand to Origami's
# ops team to configure as THEIR PAYROLL_SYNC_API_KEY; empty = endpoint always returns 401.
# Separate from ORIGAMI_API_KEY/O_CLIENT_SECRET above, which are for calls WE make outbound.
PAYROLL_SYNC_INGEST_API_KEY=
